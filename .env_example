# Same as data_prep/.env_example (paths relative to repo root)

# Copy to `.env` in this directory (or repo root) and fill in values.
# `.env` is gitignored — never commit secrets.
#
# All paths below are relative to the repository root unless noted.
#
# Load before running scripts, e.g.:
#   cd data_prep && set -a && source .env && set +a
# Or use `direnv`, or export variables manually.

# ---------------------------------------------------------------------------
# Groq (required for scripts/06_adapt_notes.py only)
# ---------------------------------------------------------------------------
# Get a key from https://console.groq.com/ — keep empty to skip LLM adaptation.
GROQ_API_KEY=

# Optional: Groq chat model id (default: meta-llama/llama-4-scout-17b-16e-instruct)
# GROQ_MODEL=

# ---------------------------------------------------------------------------
# Cohort & match artifacts (scripts/05.5, 06.5, 06, 07)
# ---------------------------------------------------------------------------
# Patient list from 05_select_patients.py or 05b (defaults vary by script if unset)
SCRIBE_SELECTED_PATIENTS_JSONL=data/staging/selected_patients.jsonl

# Match/scoring output from 04_match_and_score.py or 04b_match_and_score_golden.py
SCRIBE_MATCH_RESULTS_JSONL=data/staging/match_results.jsonl

# Convenience duplicate for golden pipeline runs (same file as golden match results)
SCRIBE_MATCH_RESULTS_GOLDEN_JSONL=data/staging/match_results_golden.jsonl

# Prior-visit window for 05.5_extract_longitudinal_context.py (integer)
SCRIBE_PRIOR_VISITS=3

# Output of 05.5 — longitudinal context consumed by 06_adapt_notes.py
SCRIBE_LONGITUDINAL_CONTEXT_JSONL=data/staging/patient_longitudinal_context.jsonl

# Optional: local ACI-Bench checkout root (if you store notes outside default layout)
# SCRIBE_ACI_BENCH_DIR=data/raw/aci_bench

# ---------------------------------------------------------------------------
# Adaptation resume (scripts/06_adapt_notes.py)
# ---------------------------------------------------------------------------
# Append / resume from existing adapted_notes.jsonl — set to 1, true, or yes
# SCRIBE_ADAPT_RESUME=1

# ---------------------------------------------------------------------------
# Hugging Face (optional — higher rate limits, cache, pinned revisions)
# ---------------------------------------------------------------------------
# HF_TOKEN=

# Optional: pin dataset revisions when running scripts/export_note_sources_to_raw.py
# MEDSYNTH_REVISION=
# MTSAMPLES_REVISION=

# Optional: Hugging Face cache directory (defaults elsewhere if unset)
# HF_HOME=

# ---------------------------------------------------------------------------
# SNOMED / Athena (optional mappers)
# ---------------------------------------------------------------------------
# Optional: NLM SNOMED CT → ICD-10-CM ExtendedMap snapshot (RF2). License via UTS/UMLS.
# SNOMED_ICD10_EXTENDED_MAP_FILE=/path/to/der2_iisssccRefset_ExtendedMapSnapshot_US1000124_YYYYMMDD.txt
# SNOMED_ICD10_MAP_REFSET_ID=

# Optional: OHDSI Athena vocabulary folder (CONCEPT.csv + CONCEPT_RELATIONSHIP.csv).
# Default if unset: <repo>/data/snomed_icd10/vocabulary
# ATHENA_VOCAB_DIR=

# ---------------------------------------------------------------------------
# Demo selector overrides (scripts/05b_select_demo_patients.py)
# ---------------------------------------------------------------------------
# DEMO_TARGET_TOTAL=20
# DEMO_ENCOUNTER_MIN=21
# DEMO_ENCOUNTER_MAX=39
# DEMO_MIN_QUALITY_SCORE=0.80
# DEMO_RANDOM_SEED=42
