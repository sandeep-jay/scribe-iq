# ============================================================================
# Scribe-IQ Backend - Environment Configuration (example)
# ============================================================================
# Copy this file to `backend/.env` and fill in secrets locally.
# NEVER commit `backend/.env` - it is gitignored.
#
# Legend used in the comments below:
#   [REQUIRED]      - backend will not start / will not function without this
#   [REQUIRED-IF]   - only required when a related provider / feature is enabled
#   [OPTIONAL]      - has a sane default in `app/config.py`
#   [FEATURE FLAG]  - turns optional behavior on/off (boolean)
#   [DEPRECATED]    - still read for backward compatibility; prefer the new name
#
# Source of truth for defaults: backend/app/config.py (class `Settings`).
# ============================================================================


# ----------------------------------------------------------------------------
# Core - database & runtime
# ----------------------------------------------------------------------------

# [REQUIRED] Postgres connection used by FastAPI, Alembic migrations,
# and the `scribe-load-corpus` CLI. The local docker-compose maps Postgres
# to host port 5433.
DATABASE_URL=postgresql://rag:<set_local_password>@127.0.0.1:5433/rag_dev

# [OPTIONAL] Log level - DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# [OPTIONAL] JSON logs are recommended for production log aggregation.
# Set to `false` for human-friendly console logs during local dev.
LOG_JSON=false

# [OPTIONAL] asyncpg pool tuning. Bump max size if many concurrent slow LLM
# calls are queueing on the DB.
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=20
# DB_POOL_COMMAND_TIMEOUT_S=30


# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------

# [OPTIONAL] Comma-separated exact origins. Defaults already include
# http://localhost and http://127.0.0.1 on ports 3000-3012, 3020, and 5173.
# Set this only when serving the UI from a non-default origin.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# [OPTIONAL] When true, also allow any localhost/127.0.0.1 port and the
# 192.168.* range via regex (handy for LAN device testing).
# Set to `false` in locked-down / production deployments.
CORS_RELAX_LOCAL=true


# ----------------------------------------------------------------------------
# LLM provider - chat & JSON generation
# ----------------------------------------------------------------------------

# [REQUIRED] Choose exactly ONE provider for chat/JSON inference.
#   groq | azure_openai | bedrock      (alias: `azure` -> azure_openai)
LLM_PROVIDER=groq

# --- Groq ------------------------------------------------------------------
# [REQUIRED-IF LLM_PROVIDER=groq]
GROQ_API_KEY=
# [OPTIONAL]
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Azure OpenAI ----------------------------------------------------------
# [REQUIRED-IF LLM_PROVIDER=azure_openai] endpoint, key, chat deployment.
# These same keys are reused by `EMBEDDING_PROVIDER=azure_openai` below.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# [OPTIONAL] Falls back to `AZURE_OPENAI_CHAT_DEPLOYMENT` when unset.
AZURE_OPENAI_JSON_DEPLOYMENT=gpt-4o-mini
# [OPTIONAL]
AZURE_OPENAI_API_VERSION=2024-10-21
# [DEPRECATED] Legacy aliases still read by config.py.
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_MINI_DEPLOYMENT=

# --- AWS Bedrock (chat/JSON via Converse) ---------------------------------
# [REQUIRED-IF LLM_PROVIDER=bedrock] region + chat model id.
AWS_REGION=us-west-2
AWS_BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# [OPTIONAL] Falls back to chat model id when unset.
AWS_BEDROCK_JSON_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# [OPTIONAL] Assume an IAM role from the base AWS session.
AWS_BEDROCK_ROLE_ARN=
# [OPTIONAL] Named profile from ~/.aws/credentials (else default chain).
BEDROCK_PROFILE_NAME=
# [DEPRECATED] Old aliases - still accepted.
# BEDROCK_CHAT_MODEL_ID=
# BEDROCK_JSON_MODEL_ID=


# ----------------------------------------------------------------------------
# Embedding provider - RAG retrieval & generated-note vectors
# ----------------------------------------------------------------------------
# Switching providers requires re-running `scribe-load-corpus --embed`
# so stored vectors and query vectors share the same embedding space.

# [REQUIRED] Choose exactly ONE embedding backend.
#   openai | azure_openai | bedrock | none      (alias: `azure` -> azure_openai)
EMBEDDING_PROVIDER=openai

# [REQUIRED] Vector dimension stored in pgvector - must match the chosen
# embedding model. The default schema uses pgvector(1536).
EMBED_DIM=1536

# --- OpenAI embeddings -----------------------------------------------------
# [REQUIRED-IF EMBEDDING_PROVIDER=openai]
OPENAI_API_KEY=
# [OPTIONAL] 1536-dim default model - matches pgvector(1536).
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_DIMENSIONS=1536

# --- Azure OpenAI embeddings ----------------------------------------------
# Reuses AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY / AZURE_OPENAI_API_VERSION above.
# [REQUIRED-IF EMBEDDING_PROVIDER=azure_openai]
# Use a deployment of `text-embedding-3-small` or `text-embedding-ada-002`
# for 1536 dimensions.
AZURE_EMBEDDING_DEPLOYMENT=
# [OPTIONAL] Only set when a text-embedding-3 deployment must down-project to EMBED_DIM.
# AZURE_EMBEDDINGS_DIMENSIONS=1536

# --- AWS Bedrock embeddings -----------------------------------------------
# [REQUIRED-IF EMBEDDING_PROVIDER=bedrock]
# Titan v1 -> 1536 dims (matches default pgvector schema).
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
# [OPTIONAL] Titan v2 supports 1024/512/256 dims; using it requires
# changing EMBED_DIM + a DB migration / full re-embed.
# AWS_BEDROCK_EMBEDDING_DIMENSIONS=1024
# [DEPRECATED] Old aliases - still accepted.
# BEDROCK_EMBEDDING_MODEL_ID=
# BEDROCK_EMBEDDING_DIMENSIONS=


# ----------------------------------------------------------------------------
# Auth (Phase 1 - no SSO)
# ----------------------------------------------------------------------------

# [OPTIONAL] Shared secret. When set, the backend requires `X-API-Key` or
# `Authorization: Bearer <token>` on all routes except /health and docs.
# Leave empty for local-only demos on 127.0.0.1.
# BACKEND_API_KEY=


# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------

# [FEATURE FLAG] Persist drafted notes from POST /notes/generate.
# Keep `false` outside trusted demos - this writes to the DB.
NOTE_GENERATION_ENABLED=false

# [FEATURE FLAG] Groq-backed patient pre-meeting summary
# (GET /patients/{id}/meeting-prep, cached in `patient_meeting_prep`).
MEETING_PREP_ENABLED=true

# [FEATURE FLAG] Responsible AI Control Center admin APIs
# (/admin/responsible-ai/*). Routes return 404 when this is false.
# Inventory: docs/architecture/IMPLEMENTED_BASELINE.md
RESPONSIBLE_AI_ADMIN_ENABLED=false
