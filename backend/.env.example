# Copy to backend/.env and fill secrets (never commit .env)

DATABASE_URL=postgresql://rag:<set_local_password>@127.0.0.1:5433/rag_dev

LOG_LEVEL=INFO
LOG_JSON=false

# When true, logs are JSON (better for production log aggregation).
# When false, logs are pretty console output (better for local dev).
# Optional override; defaults include localhost/127.0.0.1 ports 3000-3012, 3020, 5173.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Allow any localhost port + 192.168.* for LAN device testing (set false in production).
CORS_RELAX_LOCAL=true

# --- LLM provider (chat / JSON) ---
# groq | azure_openai | bedrock  (azure alias: azure)
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_JSON_DEPLOYMENT=gpt-4o-mini
# Legacy Azure aliases still supported:
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini

AWS_REGION=us-west-2
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_JSON_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_PROFILE_NAME=

# --- Embedding provider (RAG retrieval and note vectors) ---
# openai | azure_openai | bedrock | none  (azure alias: azure)
# Switching providers requires re-running `scribe-load-corpus --embed` so stored vectors
# and query vectors share the same embedding space.
EMBED_DIM=1536
EMBEDDING_PROVIDER=openai

# OpenAI embeddings (1536-dim default, matches pgvector(1536)).
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_DIMENSIONS=1536

# Azure OpenAI embeddings (reuses AZURE_OPENAI_* endpoint/key/version).
# Use a deployment of text-embedding-3-small or text-embedding-ada-002 for 1536 dimensions.
AZURE_EMBEDDING_DEPLOYMENT=
# Optional: only set when a text-embedding-3 deployment must down-project to EMBED_DIM.
# AZURE_EMBEDDINGS_DIMENSIONS=1536

# Bedrock embeddings. For the existing pgvector(1536) schema, use Titan v1.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
# Titan v2 supports 1024/512/256 dims; using it requires EMBED_DIM + DB migration/re-embed.
# BEDROCK_EMBEDDING_DIMENSIONS=1024

# Optional: require X-API-Key or Authorization: Bearer on all routes except /health and docs.
# Leave empty for local-only demos on 127.0.0.1.
# BACKEND_API_KEY=

# Opt-in guarded writes from POST /notes/generate.
NOTE_GENERATION_ENABLED=false

# Patient chart pre-meeting summary (GET /patients/{id}/meeting-prep).
MEETING_PREP_ENABLED=true

# Responsible AI Control Center admin APIs (/admin/responsible-ai/*).
# Inventory: docs/architecture/IMPLEMENTED_BASELINE.md
RESPONSIBLE_AI_ADMIN_ENABLED=true
