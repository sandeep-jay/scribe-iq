# Copy to backend/.env and fill secrets (never commit .env)

DATABASE_URL=postgresql://rag:rag_dev_password@127.0.0.1:5433/rag_dev

LOG_LEVEL=INFO
# Optional override; defaults include localhost/127.0.0.1 ports 3000–3012, 3020, 5173.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Allow any localhost port + 192.168.* for LAN device testing (set false in production).
CORS_RELAX_LOCAL=true

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini

EMBED_DIM=1536
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_DIMENSIONS=1536

# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Optional: require X-API-Key or Authorization: Bearer on all routes except /health and docs.
# Leave empty for local-only demos on 127.0.0.1.
# BACKEND_API_KEY=

# Opt-in guarded writes from POST /notes/generate.
NOTE_GENERATION_ENABLED=false

# Groq-backed patient chart pre-meeting summary (GET /patients/{id}/meeting-prep).
MEETING_PREP_ENABLED=true

# Responsible AI Control Center admin APIs (/admin/responsible-ai/*).
# Inventory: reference-docs/SCRIBE_IQ_IMPLEMENTED_BASELINE.md
RESPONSIBLE_AI_ADMIN_ENABLED=true

