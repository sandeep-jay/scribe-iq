# ============================================================================
# Scribe-IQ Frontend (Next.js) - Environment Configuration (example)
# ============================================================================
# Copy to `frontend/.env.local` and edit locally. `.env.local` is gitignored
# by Next.js convention and overrides everything else.
#
# Next.js env-file precedence (highest first):
#   .env.local  >  .env.${NODE_ENV}  >  .env
#
# SECURITY: SECURITY: every NEXT_PUBLIC_* value is inlined into the browser bundle
# at build time. Never put server-only secrets (DB strings, API keys) behind
# a NEXT_PUBLIC_ prefix.
#
# Legend:
#   [REQUIRED]   - UI will fail to call the backend without this
#   [OPTIONAL]   - has a sane default or only used for opt-in features
# ============================================================================


# ----------------------------------------------------------------------------
# Backend API
# ----------------------------------------------------------------------------

# [REQUIRED] Base URL the browser and SSR use to reach FastAPI.
# Local dev: uvicorn defaults to 127.0.0.1:8000.
NEXT_PUBLIC_SCRIBE_API_BASE=http://127.0.0.1:8000

# [OPTIONAL] Only needed when the backend has `BACKEND_API_KEY` set.
# Prefer NOT shipping production keys to the browser - use an auth proxy
# or server-side route handler instead when possible.
# NEXT_PUBLIC_SCRIBE_BACKEND_API_KEY=


# ----------------------------------------------------------------------------
# Feature flags (UI chrome)
# ----------------------------------------------------------------------------

# [OPTIONAL] Show the Responsible AI Control Center in the UI shell.
# Must be paired with backend `RESPONSIBLE_AI_ADMIN_ENABLED=true`.
# See docs/architecture/IMPLEMENTED_BASELINE.md (section 4).
NEXT_PUBLIC_SCRIBE_ADMIN_UI=true
