# ============================================================================
# Scribe-IQ data_prep - Environment Configuration (example)
# ============================================================================
# Copy this file to `data_prep/.env` (or repo root `.env`) and fill in values.
# `.env` is gitignored - never commit secrets.
#
# Load before running scripts, e.g.:
#   cd data_prep && set -a && source .env && set +a
# Or use `direnv` / export variables manually.
#
# All paths below are relative to the repository root unless noted.
#
# Legend:
#   [REQUIRED-FOR <script>]   - that script will fail without this
#   [OPTIONAL]                - has a sane default or only used by some scripts
# ============================================================================


# ----------------------------------------------------------------------------
# Groq - LLM adaptation
# ----------------------------------------------------------------------------

# [REQUIRED-FOR scripts/06_adapt_notes.py]
# Get a key from https://console.groq.com/. Leave empty to skip LLM adaptation.
GROQ_API_KEY=

# [OPTIONAL] Defaults to `meta-llama/llama-4-scout-17b-16e-instruct`.
# GROQ_MODEL=


# ----------------------------------------------------------------------------
# Cohort & match artifacts
# Consumed by scripts 04, 04b, 05, 05b, 05.5, 06, 06.5, 07.
# ----------------------------------------------------------------------------

# [OPTIONAL] Patient list produced by 05_select_patients.py or 05b.
# Default varies by script when unset.
SCRIBE_SELECTED_PATIENTS_JSONL=data/staging/selected_patients.jsonl

# [OPTIONAL] Match/scoring output from 04_match_and_score.py or
# 04b_match_and_score_golden.py.
SCRIBE_MATCH_RESULTS_JSONL=data/staging/match_results.jsonl

# [OPTIONAL] Convenience duplicate for golden-pipeline runs.
SCRIBE_MATCH_RESULTS_GOLDEN_JSONL=data/staging/match_results_golden.jsonl

# [OPTIONAL] Prior-visit window for 05.5_extract_longitudinal_context.py.
SCRIBE_PRIOR_VISITS=3

# [OPTIONAL] Output of 05.5 - longitudinal context consumed by 06_adapt_notes.py.
SCRIBE_LONGITUDINAL_CONTEXT_JSONL=data/staging/patient_longitudinal_context.jsonl

# [OPTIONAL] Local ACI-Bench checkout root, if stored outside the default layout.
# SCRIBE_ACI_BENCH_DIR=data/raw/aci_bench


# ----------------------------------------------------------------------------
# Adaptation resume
# ----------------------------------------------------------------------------

# [OPTIONAL] Append/resume scripts/06_adapt_notes.py from an existing
# adapted_notes.jsonl. Truthy values: 1 / true / yes.
# SCRIBE_ADAPT_RESUME=1


# ----------------------------------------------------------------------------
# Hugging Face - dataset downloads (optional)
# ----------------------------------------------------------------------------

# [OPTIONAL] Higher Hugging Face Hub rate limits.
# HF_TOKEN=

# [OPTIONAL] Pin dataset revisions for scripts/export_note_sources_to_raw.py.
# MEDSYNTH_REVISION=
# MTSAMPLES_REVISION=

# [OPTIONAL] Hugging Face cache directory (defaults elsewhere when unset).
# HF_HOME=


# ----------------------------------------------------------------------------
# SNOMED / Athena vocabularies (optional mappers)
# ----------------------------------------------------------------------------

# [OPTIONAL] NLM SNOMED CT -> ICD-10-CM ExtendedMap snapshot (RF2).
# Licensed via UTS/UMLS. Unzip US Edition so the file is reachable.
# SNOMED_ICD10_EXTENDED_MAP_FILE=/path/to/der2_iisssccRefset_ExtendedMapSnapshot_US1000124_YYYYMMDD.txt

# [OPTIONAL] Override the refset filter (default ICD-10-CM map: 6011000124106).
# SNOMED_ICD10_MAP_REFSET_ID=

# [OPTIONAL] OHDSI Athena vocabulary folder (CONCEPT.csv + CONCEPT_RELATIONSHIP.csv).
# Default when unset: <repo>/data/snomed_icd10/vocabulary
# ATHENA_VOCAB_DIR=


# ----------------------------------------------------------------------------
# Demo selector overrides (scripts/05b_select_demo_patients.py)
# ----------------------------------------------------------------------------

# [OPTIONAL]
# DEMO_TARGET_TOTAL=20
# DEMO_ENCOUNTER_MIN=21
# DEMO_ENCOUNTER_MAX=39
# DEMO_MIN_QUALITY_SCORE=0.80
# DEMO_RANDOM_SEED=42
